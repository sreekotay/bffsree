fun check_tree(depth, value) {
    if (depth == 0) {
        return value;
    }
    return value +
        check_tree(depth - 1, value * 2) +
        check_tree(depth - 1, value * 2 + 1);
}

let var checksum = 0;
for (let var i = 0; i < 100; ++i) {
    checksum = (checksum + check_tree(7, 1)) & 0xFF_FF_FF_FF;
}
$println(checksum);
